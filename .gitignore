# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
*.translation

# Imported translations (Godot 3)
*.import
# Except the raw original-audio WAVs: wr1_audio.gd reads their bytes directly,
# so they ship unimported ("keep") rather than as lossy QOA samples.
!assets/audio/original/playback/*.wav.import

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export templates
*.pck
*.zip

# OS-specific
.DS_Store
Thumbs.db
*.swp
*~

# IDE / Editor
.vscode/
*.code-workspace

# Build / export
build/
export/

# Visual regression testing — generated artifacts, not source.
# (BSV2 replays + the JSON they parse to + the DOSBox reference PNGs are
# all regeneratable from a `lr.py record` session. Sentinel PNGs and the
# asset-extraction research doc ARE source — keep.)
testing/output/
testing/reference/
testing/replays/

# Raw extracted GX Library blobs — the _png/ dirs are the usable form.
assets/extracted/wr1_1/
assets/extracted/wr1_2/

# Python bytecode cache
__pycache__/
.claude/

# OpenTofu working directory and local state (infra/ holds only the config).
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
